{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "always-update": true,
  "draft-pull-request": true,
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "release-type": "rust",
  "packages": {
    "post-compute": {
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'tee-worker-post-compute')].version"
        }
      ]
    },
    "pre-compute": {
      "extra-files": [
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'tee-worker-pre-compute')].version"
        }
      ]
    }
  }
}
